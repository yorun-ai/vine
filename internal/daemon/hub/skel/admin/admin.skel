domain vine.hub.admin

@desc("Hub operator using the Dashboard on the admin listener")
actor AdminActor {
    via client {}
}

@desc("Hub's Admin API service, called by the Dashboard")
api service AdminApiService {
    for AdminActor via client
    auth optional

    @desc("Whether Hub configuration is read-only")
    method readOnly {
        output bool
    }

    @desc("Vine runtime version of the running Hub")
    method version {
        output string
    }
}
