domain vine.hub.admin

@desc("Explicit or automatically derived HTTP transport behavior")
enum PortalSwitchMode {
    ENABLED
    DISABLED
    AUTO
}

@desc("Portal access entry")
data PortalEntryHTTP {
    @desc("Match Host; empty means IP access over HTTP only")
    host: string
    @desc("HTTP transport mode; defaults to AUTO")
    http: PortalSwitchMode
    @desc("HTTP listener port")
    httpPort: int
    @desc("HTTPS transport mode; defaults to AUTO")
    https: PortalSwitchMode
    @desc("HTTPS listener port")
    httpsPort: int
    @desc("HTTP-to-HTTPS redirect mode (308); defaults to AUTO")
    autohttps: PortalSwitchMode
}
@desc("Hub-computed transport settings; certificate validity is checked by Portal")
data PortalEntryEffectiveHTTP {
 host: string
 httpEnabled: bool
 httpPort: int
 httpsEnabled: bool
 httpsPort: int
 autohttpsEnabled: bool
 httpsReason: string
}
data PortalEntry {
 protocol: string
 http: PortalEntryHTTP
 effectiveHTTP: PortalEntryEffectiveHTTP
    @desc("Entry ID")
    id: int

    @desc("Entry name")
    name: string

    @desc("Listener IP addresses; empty preserves the default wildcard TCP listener")
    listenIPs: list<string>

    @desc("Entry rule list")
    rules: list<PortalEntryRule>

    @desc("Whether Hub publishes this entry and its rules to Portal")
    enabled: bool

}

@desc("Portal access entry update parameters")
data PortalEntryUpdate {
 protocol: string?
 @desc("Replace the complete HTTP block; omitted switches default to AUTO; null is invalid")
 http: PortalEntryHTTP?
    @desc("Entry name")
    name: string?

    @desc("Listener IP addresses; empty restores the default wildcard TCP listener")
    listenIPs: list<string>?

    @desc("Whether Hub publishes this entry and its rules to Portal")
    enabled: bool?
}

@desc("Portal access entry creation parameters")
data PortalEntryCreation {
 protocol: string
 @desc("Replace the complete HTTP block; omitted switches default to AUTO; null is invalid")
 http: PortalEntryHTTP?
    @desc("Entry name")
    name: string

    @desc("Listener IP addresses; empty preserves the default wildcard TCP listener")
    listenIPs: list<string>

    @desc("Whether Hub publishes this entry and its rules to Portal; defaults to true")
    enabled: bool?
}

@desc("Portal access entry rules")
data PortalEntryRule {
    @desc("Entry rules")
    rule: PortalRuleListItem

    @desc("Target site")
    site: PortalSiteListItem?
    }

@desc("Hub's Portal access entry service, called by the Portal admin client")
api service PortalEntryApiService {
    for AdminActor
    auth optional

    @desc("List Portal access entries")
    method list {
        @desc("Portal access entry list")
        output list<PortalEntry>
    }

    @desc("Create a Portal access entry")
    method create {
        input {
            @desc("Portal access entry creation parameters")
            creation: PortalEntryCreation
        }
        @desc("Portal access entry")
        output PortalEntry
    }

    @desc("Modify a Portal access entry")
    method update {
        input {
            @desc("Entry ID")
            id: int

            @desc("Portal access entry update parameters")
            update: PortalEntryUpdate
        }
        @desc("Portal access entry")
        output PortalEntry
    }

    @desc("Delete a Portal access entry that routes no rule")
    method remove {
        input {
            @desc("Entry ID")
            id: int
        }
    }
}
