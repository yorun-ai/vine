domain vine.hub.admin

@desc("Portal access entry")
data PortalEntryHTTP {
    @desc("Enable HTTP transport")
    httpEnabled: bool
    @desc("HTTP listener port")
    httpPort: int
    @desc("Enable HTTPS transport")
    httpsEnabled: bool
    @desc("HTTPS listener port")
    httpsPort: int
    @desc("Redirect HTTP to HTTPS with status 308")
    autoHTTPS: bool
}
data PortalEntryHTTPUpdate {
 httpEnabled: bool?
 httpPort: int?
 httpsEnabled: bool?
 httpsPort: int?
 autoHTTPS: bool?
}
data PortalEntry {
 protocol: string
 http: PortalEntryHTTP
    @desc("Entry ID")
    id: int

    @desc("Entry name")
    name: string

    @desc("Entry protocol")
    scheme: string

    @desc("Match Host, empty string means no restriction")
    host: string

    @desc("Entry port")
    port: int

    @desc("Listener IP addresses; empty preserves the default wildcard TCP listener")
    listenIPs: list<string>

    @desc("Entry rule list")
    rules: list<PortalEntryRule>

    @desc("Whether Hub publishes this entry and its rules to Portal")
    enabled: bool

}

@desc("Portal access entry update parameters")
data PortalEntryUpdate {
 protocol: string?
 http: PortalEntryHTTPUpdate?
    @desc("Entry name")
    name: string?

    @desc("Entry protocol")
    scheme: string?

    @desc("Match Host, empty string means no restriction")
    host: string?

    @desc("Entry port")
    port: int?

    @desc("Listener IP addresses; empty restores the default wildcard TCP listener")
    listenIPs: list<string>?

    @desc("Whether Hub publishes this entry and its rules to Portal")
    enabled: bool?
}

@desc("Portal access entry creation parameters")
data PortalEntryCreation {
 protocol: string?
 http: PortalEntryHTTPUpdate?
    @desc("Entry name")
    name: string

    @desc("Entry protocol")
    scheme: string?

    @desc("Match Host, empty string means no restriction")
    host: string

    @desc("Entry port")
    port: int?

    @desc("Listener IP addresses; empty preserves the default wildcard TCP listener")
    listenIPs: list<string>

    @desc("Whether Hub publishes this entry and its rules to Portal; defaults to true")
    enabled: bool?
}

@desc("Portal access entry rules")
data PortalEntryRule {
    @desc("Entry rules")
    rule: PortalRuleListItem

    @desc("Target site")
    site: PortalSiteListItem?
    }

@desc("Hub's Portal access entry service, called by the Portal admin client")
api service PortalEntryApiService {
    for AdminActor via client
    auth optional

    @desc("List Portal access entries")
    method list {
        @desc("Portal access entry list")
        output list<PortalEntry>
    }

    @desc("Create a Portal access entry")
    method create {
        input {
            @desc("Portal access entry creation parameters")
            creation: PortalEntryCreation
        }
        @desc("Portal access entry")
        output PortalEntry
    }

    @desc("Modify a Portal access entry")
    method update {
        input {
            @desc("Entry ID")
            id: int

            @desc("Portal access entry update parameters")
            update: PortalEntryUpdate
        }
        @desc("Portal access entry")
        output PortalEntry
    }

    @desc("Delete a Portal access entry that routes no rule")
    method remove {
        input {
            @desc("Entry ID")
            id: int
        }
    }
}
