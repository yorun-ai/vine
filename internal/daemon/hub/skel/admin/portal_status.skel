domain vine.hub.admin

@desc("Portal instance status view for Dashboard display")
data PortalStatusView {
    @desc("Portal instance ID")
    instanceId: string

    @desc("Portal version")
    version: string
}

@desc("Hub Dashboard's Portal instance status service")
api service PortalStatusApiService {
    @desc("List Portal instance statuses")
    method list {
        output list<PortalStatusView>
    }
}
