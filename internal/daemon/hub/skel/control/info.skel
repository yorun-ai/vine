domain vine.hub.control

@desc("Hub information")
pub data Info {
    @desc("Hub Vine runtime version")
    version: string

    @desc("Control API service port")
    apiPort: int

    @desc("Configuration and service discovery watch port")
    watchPort: int

    @desc("Whether MQ is embedded in Hub")
    mqEmbedded: bool

    @desc("Embedded NATS service port")
    mqNatsPort: int

    @desc("External NATS service endpoint")
    mqNatsEndpoint: string

    @desc("Lock mode: embedded, redis or disable")
    lockMode: string

    @desc("External Redis endpoint for locks")
    lockRedisEndpoint: string

    @desc("Redis service port")
    @deprecated("Use watchPort instead")
    redisPort: int

    @desc("NATS service port")
    @deprecated("Use mqNatsPort instead")
    natsPort: int

    @desc("External NATS service endpoint")
    @deprecated("Use mqNatsEndpoint instead")
    mqEndpoint: string
}

@desc("Hub's information service, called by Link")
pub service InfoService {
    @desc("Read Hub information")
    method getInfo {
        @desc("Hub information")
        output Info
    }
}
